{
	"name": "server-ufsj-curriculum",
	"version": "1.0.0",
	"scripts": {
		"start": "nodemon -r tsconfig-paths/register src/index.ts --quiet",
		"build": "tsc",
		"prepare": "ts-patch install -s",
		"db:setup": "npm run db:generate && npm run db:push",
		"db:generate": "prisma generate --no-hints",
		"db:push": "prisma db push --skip-generate",
		"db:reset": "prisma migrate reset --force",
		"test": "dotenv -e .env.test -- jest --runInBand"
	},
	"dependencies": {
		"@prisma/client": "^6.4.1",
		"bcryptjs": "^3.0.2",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^16.0.3",
		"express": "^4.18.2",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^7.0.3",
		"ms": "^2.1.3",
		"uninstall": "^0.0.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.8",
		"@types/cors": "^2.8.13",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/node": "^18.15.11",
		"axios": "^1.8.1",
		"dotenv-cli": "^8.0.0",
		"jest": "^29.7.0",
		"nodemon": "^3.1.9",
		"prisma": "^6.4.1",
		"ts-jest": "^29.2.6",
		"ts-node": "^10.9.1",
		"ts-patch": "^2.1.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.0.3",
		"wait-on": "^8.0.2"
	}
}
